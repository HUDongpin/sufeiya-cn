# Reserved for the future account and cloud-data phase. Gate A does not load Clerk at runtime.
# Clerk values are provisioned by the connected Vercel Marketplace resource.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public route configuration; these values are not secrets.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# Optional server-side AI Gateway settings for the Gate A Super Teacher.
# Vercel deployments can authenticate with the automatically issued OIDC token;
# a local developer may instead provide AI_GATEWAY_API_KEY. Never expose either
# value through a NEXT_PUBLIC_ variable.
AI_GATEWAY_API_KEY=
SUFEIYA_AI_MODEL=zai/glm-4.6v-flash
# Keep false until provider/data-transfer approval, durable abuse controls, and
# semantic citation validation are all closed. Enabling is an explicit release act.
SUFEIYA_AI_ENABLED=false
SUFEIYA_RATE_LIMIT_SALT=
