# Clerk keys are read only by the account boundary. Empty or invalid pairs render
# a safe configuration notice on protected pages. Never expose CLERK_SECRET_KEY.
# Provision real values through the connected Vercel Marketplace resource.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public route configuration; these values are not secrets.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# Optional server-side model settings for the Gate A Sofia teacher. These values
# only describe a requested configuration. They cannot override the versioned
# release decisions in data/release-decision-register.v1.json, and the mere
# presence of a credential never permits learner data to leave the application.
# Never expose these through a NEXT_PUBLIC_ variable.
SUFEIYA_AI_PROVIDER=dashscope
AI_GATEWAY_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=beijing
# Optional for newer workspace-scoped keys. Legacy DashScope keys use the fixed
# regional endpoint and leave this empty.
DASHSCOPE_WORKSPACE_ID=
SUFEIYA_AI_MODEL=qwen3.8-max
# This switch requests model use only after every canonical release control is
# approved. Responses still pass the source-ID, unsafe-claim, policy, and
# manual-fallback gates.
SUFEIYA_AI_ENABLED=false
SUFEIYA_RATE_LIMIT_SALT=

# Sofia voice is a separately governed release. These environment values cannot
# replace the canonical decision register. Output and microphone input remain
# disabled until every applicable release control and reviewed transport are
# approved.
SUFEIYA_TTS_MODEL=qwen3-tts-vc-realtime-2026-01-15
SUFEIYA_VOICE_AUTHORIZATION_STATUS=pending_review
SUFEIYA_VOICE_DATA_FLOW_STATUS=pending_review
SUFEIYA_VOICE_DELETION_STATUS=pending_review
SUFEIYA_VOICE_PROFILE_APPROVED=false
SUFEIYA_VOICE_OUTPUT_ENABLED=false
SUFEIYA_MIC_INPUT_ENABLED=false
# Server-only voice ID. Never expose it through a NEXT_PUBLIC_ variable.
SUFEIYA_QWEN_VOICE_ID=
