{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sufeiya.cn/schemas/learning-event.schema.v2.json",
  "title": "Sufeiya local learning event v2",
  "description": "Strict, forward-only, anonymous, runtime-enabled browser-local learning-event contract. Runtime capture is permitted only within this contract; network dispatch is forbidden.",
  "$comment": "Runtime assertions not expressible by single-event JSON Schema: validate the actual candidate event against this schema before append; require recordedAt >= occurredAt; require eventId and idempotencyKey uniqueness across the ledger; allow sequence 1 to be any allowlisted post-activation event; prohibit same-cycle phase regression and historical backfill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "eventId",
    "idempotencyKey",
    "eventType",
    "sequence",
    "occurredAt",
    "recordedAt",
    "subject",
    "context",
    "activity",
    "attributes",
    "privacy",
    "governance",
    "previousEventHash",
    "eventHash"
  ],
  "properties": {
    "contractId": {
      "const": "sufeiya.learning-event.v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "eventId": {
      "$ref": "#/$defs/uuidV4"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/uuidV4"
    },
    "eventType": {
      "enum": [
        "learning_cycle.started",
        "recommendation.decided",
        "practice_attempt.finalized",
        "check_in.committed",
        "retest.completed",
        "learning_cycle.completed"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "$ref": "#/$defs/utcMilliseconds"
    },
    "recordedAt": {
      "$ref": "#/$defs/utcMilliseconds"
    },
    "subject": {
      "$ref": "#/$defs/anonymousSubject"
    },
    "context": {
      "$ref": "#/$defs/eventContext"
    },
    "activity": {
      "type": "object"
    },
    "attributes": {
      "$ref": "#/$defs/eventAttributes"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "previousEventHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "eventHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "previousEventHash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previousEventHash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/learningCycleStarted"
    },
    {
      "$ref": "#/$defs/recommendationDecided"
    },
    {
      "$ref": "#/$defs/practiceAttemptFinalized"
    },
    {
      "$ref": "#/$defs/checkInCommitted"
    },
    {
      "$ref": "#/$defs/retestCompleted"
    },
    {
      "$ref": "#/$defs/learningCycleCompleted"
    }
  ],
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "anonymousSubjectId": {
      "type": "string",
      "pattern": "^anon_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcMilliseconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "anonymousSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId",
        "subjectType",
        "identityAssurance",
        "assignedBy"
      ],
      "properties": {
        "subjectId": {
          "$ref": "#/$defs/anonymousSubjectId"
        },
        "subjectType": {
          "const": "anonymous_installation"
        },
        "identityAssurance": {
          "const": "local_random_alias"
        },
        "assignedBy": {
          "const": "local_runtime_csprng"
        }
      }
    },
    "eventContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learningCycleId": {
          "$ref": "#/$defs/uuidV4"
        },
        "diagnosticSessionId": {
          "$ref": "#/$defs/uuidV4"
        },
        "planId": {
          "$ref": "#/$defs/uuidV4"
        },
        "recommendationId": {
          "$ref": "#/$defs/uuidV4"
        },
        "bindingId": {
          "$ref": "#/$defs/uuidV4"
        },
        "taskId": {
          "$ref": "#/$defs/uuidV4"
        },
        "attemptId": {
          "$ref": "#/$defs/uuidV4"
        },
        "practiceReceiptId": {
          "$ref": "#/$defs/uuidV4"
        },
        "checkInId": {
          "$ref": "#/$defs/uuidV4"
        },
        "retestId": {
          "$ref": "#/$defs/uuidV4"
        },
        "baselinePracticeReceiptId": {
          "$ref": "#/$defs/uuidV4"
        },
        "humanReviewReceiptId": {
          "$ref": "#/$defs/uuidV4"
        },
        "updatedPlanId": {
          "$ref": "#/$defs/uuidV4"
        },
        "causationEventId": {
          "$ref": "#/$defs/uuidV4"
        }
      }
    },
    "eventAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "started",
            "matched",
            "needs_retry",
