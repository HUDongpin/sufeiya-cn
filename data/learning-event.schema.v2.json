            "evidence_insufficient"
          ]
        },
        "automatedScoreProduced": {
          "const": false
        },
        "formalDiagnosisProduced": {
          "const": false
        },
        "officialEquivalenceClaimed": {
          "const": false
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "selfCheckCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "evidenceClass": {
          "const": "practice_receipt"
        },
        "questionStatus": {
          "enum": [
            "none",
            "has_question"
          ]
        },
        "evidenceSufficiency": {
          "enum": [
            "limited_unreviewed_same_skill_task",
            "insufficient_audio_conditions"
          ]
        },
        "comparabilityClass": {
          "const": "same_skill_unreviewed_construct"
        },
        "humanConfirmationStatus": {
          "enum": [
            "not_required_for_gate_a_flow",
            "required_not_completed",
            "completed"
          ]
        },
        "growthClaimed": {
          "const": false
        },
        "nextFocusSkill": {
          "$ref": "#/$defs/focusSkill"
        }
      }
    },
    "skill": {
      "enum": [
        "Reading",
        "Listening",
        "Writing",
        "Speaking"
      ]
    },
    "focusSkill": {
      "enum": [
        "Reading",
        "Listening",
        "Writing",
        "Speaking",
        "Balanced"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
